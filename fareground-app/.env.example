# Copy to .env.local (git-ignored) and set the backend address.
#
# This must be an address your PHONE can reach. "localhost" on a phone is the
# phone itself. Use your computer's LAN IP - find it with `ipconfig` on
# Windows, under "IPv4 Address" - and make sure the phone is on the same Wi-Fi.
#
# Android emulator only: http://10.0.2.2:3000 reaches the host machine.
#
# EXPO_PUBLIC_ values are baked into the app bundle, so never put a secret here.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# --- Ads (AdMob). Leave empty to use Google's TEST ads (safe while developing).
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# --- Google sign-in: the WEB OAuth client id (same value as the backend's
# GOOGLE_CLIENT_IDS). Empty = the "Continue with Google" button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
