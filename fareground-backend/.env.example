# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Where the API listens.
PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkscape

# Secret used to sign JWTs. Generate a long random one, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login token stays valid ("15m", "24h", "7d", ...).
JWT_EXPIRES_IN=90d

# bcrypt cost factor. Higher = slower = harder to brute force. 12 is a good default.
BCRYPT_SALT_ROUNDS=12

# --- Device attestation (iOS App Attest / Android Play Integrity) ---
# off       do not check at all (local development)
# optional  verify when supplied, never block (use while rolling out)
# required  no valid attestation, no step sync
ATTESTATION_MODE=off

# Needed once you implement the Apple verifier.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=

# Needed once you implement the Android verifier.
ANDROID_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Rate limits ---
# Leave these unset in production to get the sane defaults (20 / 120).
# Local development raises them so the e2e suite is not throttled.
RATE_LIMIT_AUTH_MAX=2000
RATE_LIMIT_API_MAX=5000

# Reverse proxies in front of the server. 0 on your PC; 1 on Render/Railway.
TRUST_PROXY=0

# --- Rewarded ads ---
# client = trust the phone (dev: Google can't reach a server on your Wi-Fi)
# ssv    = wait for Google's signed callback to GET /rewards/ssv (production)
AD_REWARD_VERIFICATION=client

# --- Google sign-in ---
# The WEB OAuth client id(s) from Google Cloud Console, comma separated.
# Empty = the Google button reports "not set up yet".
GOOGLE_CLIENT_IDS=
