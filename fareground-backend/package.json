{
  "name": "fareground-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fareground backend - Step 1: auth, step sync, parcel purchases, lazy coin evaluation",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game/rules.test.ts src/game/grid.test.ts src/game/badges.test.ts src/game/avatar.test.ts",
    "test:api": "powershell -ExecutionPolicy Bypass -File tests/e2e.ps1",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "test:db": "tsx tests/leaderboard.settle.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
